# --- vent-inventor-gateway (Windows, рядом с Inventor) ---
SERVER_EXE=C:\inverter_mcp\_forks\ipt-mcp\src\server\bin\Release\net8.0\Bimwright.Ipt.Server.exe
# read-only профиль по умолчанию; для рабочей сессии уберите --read-only и расширьте toolsets
SERVER_ARGS=--read-only --toolsets meta,query,document,parameters,properties,assembly_query,vent --timeout-ms 60000
GATEWAY_TOKEN=change-me-strong-token
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8737
# по умолчанию все тулзы; сузьте при необходимости:
# TOOL_ALLOWLIST=inventor_vent_list_products,inventor_vent_open_product,inventor_vent_check_part,inventor_vent_bom_report
