# --- vent-inventor-gateway (Windows, рядом с Inventor) ---
SERVER_EXE=C:\inverter_mcp\_forks\ipt-mcp\src\server\bin\Release\net8.0\Bimwright.Ipt.Server.exe
# read-only профиль по умолчанию; для рабочей сессии уберите --read-only и расширьте toolsets
SERVER_ARGS=--read-only --toolsets meta,query,document,parameters,properties,assembly_query,vent --timeout-ms 60000
# Product Job v2 edit-профиль (вместо строки выше, только за role/approval):
# SERVER_ARGS=--toolsets meta,query,document,parameters,properties,sketch,feature,assembly,assembly_query,export,vent --timeout-ms 120000
GATEWAY_TOKEN=change-me-strong-token
NODE_ENV=production
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8737
# Пустое значение = встроенный безопасный allowlist для конструктора; произвольный send_code запрещён.
# TOOL_ALLOWLIST=inventor_health,inventor_vent_list_products,inventor_vent_open_product
RATE_LIMIT_PER_MINUTE=120
REQUEST_BODY_MAX_BYTES=1048576
AUDIT_LOG_PATH=C:\ProgramData\KVZ\inventor-gateway-audit.jsonl
# Offline release worker. Сначала установите pinned dxf_tools/requirements.txt в этот Python.
BIMWRIGHT_INVENTOR_EXPORT_ROOT=D:\DXF_OUT
RELEASE_PYTHON=C:\Python312\python.exe
RELEASE_SCRIPT=C:\inverter_mcp\dxf_tools\release.py
# URL/токен подаются из 1Password/runtime, не коммитятся. Без URL publish-tool не регистрируется.
# RELEASE_WEBHOOK_URL=https://kvz-ai.internal/hooks/inventor-release
# RELEASE_WEBHOOK_BEARER=
