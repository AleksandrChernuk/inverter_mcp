# --- kvz-inventor-connector (копируется в kvz-ai как connectors/inventor) ---
GATEWAY_URL=http://<windows-inventor-host>:8737
GATEWAY_TOKEN=change-me-strong-token
# 0 = только read-тулзы (по умолчанию). 1 = добавить write-тулзы (включает kvz-ai по роли + approval).
WRITE_ENABLED=0
# В production пустой токен запрещён.
NODE_ENV=production
# Один CAD-вызов может быть долгим, но всегда ограничен.
GATEWAY_TIMEOUT_MS=120000
# Персистентные JobSpec/checkpoint и append-only аудит (не хранить здесь секреты).
JOB_STATE_DIR=/var/lib/kvz-ai/inventor/jobs
AUDIT_LOG_PATH=/var/log/kvz-ai/inventor-audit.jsonl
# Comma-separated recipe template digests approved by the chief engineer (required for v2 in production).
APPROVED_RECIPE_DIGESTS=
