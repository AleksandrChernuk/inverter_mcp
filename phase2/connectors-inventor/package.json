{
  "name": "kvz-inventor-connector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP connector for kvz-ai: bounded vent/Inventor tools, forwards to the on-prem gateway over HTTP. Read-only by default; write tools gated by role/approval.",
  "bin": { "inventor": "dist/server.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "engines": { "node": ">=20" }
}
