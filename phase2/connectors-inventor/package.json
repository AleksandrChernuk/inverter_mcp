{
  "name": "kvz-inventor-connector",
  "version": "0.3.0",
  "private": true,
  "packageManager": "pnpm@8.10.0",
  "type": "module",
  "description": "MCP connector for kvz-ai: bounded vent/Inventor tools, forwards to the on-prem gateway over HTTP. Read-only by default; write tools gated by role/approval.",
  "bin": { "inventor": "dist/server.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.19.2",
    "typescript": "5.6.3"
  },
  "engines": { "node": ">=20" }
}
